##### ConcurrentHashMap版
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.LongAdder;

public class AntiFraudSlidingWindow {

    // 1分钟切分成60个格子，每个格子代表1秒
    private static final int WINDOW_SIZE_SECONDS = 60;

    // 核心复合 Key：UserId + "_" + SkuId
    // 采用 ConcurrentHashMap 承载高并发
    private final ConcurrentHashMap<String, WindowBucket[]> monitorMap = new ConcurrentHashMap<>(131072);

    /**
     * 格子实体：使用 LongAdder 彻底消灭锁竞争
     */
    private static class WindowBucket {
        final long volatile timestampSeconds; // 记录这个格子当前代表的具体秒数
        final LongAdder counter;

        WindowBucket(long timestampSeconds) {
            this.timestampSeconds = timestampSeconds;
            this.counter = new LongAdder();
            this.counter.add(0);
        }
    }

    /**
     * 核心写入与防刷校验接口
     * @return 过去 1 分钟内的总点击次数
     */
    public long clickAndGetCount(String userId, String skuId) {
        String key = userId + "_" + skuId;
        long currentSeconds = System.currentTimeMillis() / 1000;
        int index = (int) (currentSeconds % WINDOW_SIZE_SECONDS);

        // 1. 获取或初始化该用户该 SKU 的 60秒 环形数组
        WindowBucket[] buckets = monitorMap.computeIfAbsent(key, k -> {
            WindowBucket[] arr = new WindowBucket[WINDOW_SIZE_SECONDS];
            for (int i = 0; i < WINDOW_SIZE_SECONDS; i++) {
                arr[i] = new WindowBucket(0); // 初始秒数为 0
            }
            return arr;
        });

        WindowBucket bucket = buckets[index];

        // 2. 检查当前格子的时间戳，实现“无锁平滑滚动重置”
        if (bucket.timestampSeconds != currentSeconds) {
            // 说明这个格子是 1 分钟前留下的老格子，需要清空重置为当前秒
            synchronized (bucket) { 
                // 极小粒度的锁，只有在每秒跨度的那一头一尾发生微弱竞争
                if (bucket.timestampSeconds != currentSeconds) {
                    bucket.counter.reset(); // 清空历史数字
                    // 必须最后修改时间戳（ volatile 语义保障可见性 ），防止其他线程在重置完前写入
                    // 注：此处若追求极致性能，可将 timestampSeconds 设为 volatile 并在外面配合 CAS
                    // 本处使用简易轻量级 synchronized 锁住单个格子，在高分流下竞争极小
                    bucket.timestampSeconds = currentSeconds; 
                }
            }
        }

        // 3. 增量累加当前这一秒的点击数 (O(1) 无锁)
        bucket.counter.increment();

        // 4. 顺着环形数组，累加过去 60 秒内所有未过期的有效格子
        long totalClicks = 0;
        for (WindowBucket b : buckets) {
            // 只有时间戳在当前 1 分钟内的格子才算数
            if (currentSeconds - b.timestampSeconds < WINDOW_SIZE_SECONDS) {
                totalClicks += b.counter.sum();
            }
        }

        return totalClicks;
    }
}

##### Coffein版
import com.github.benmanes.caffeine.cache.Cache;
import com.github.benmanes.caffeine.cache.Caffeine;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.LongAdder;

public class AntiFraudCaffeineFDS {

    // 60个格子代表60秒
    private static final int WINDOW_SIZE = 60;

    /**
     * 每一个格子（槽位）的实体
     */
    private static class DiskBucket {
        // 必须置 volatile，保证跨线程的“过期判定”可见性
        volatile long timestampSeconds; 
        final LongAdder counter;

        DiskBucket(long timestampSeconds) {
            this.timestampSeconds = timestampSeconds;
            this.counter = new LongAdder();
        }
    }

    /**
     * 每个用户+SKU 拥有的独立窗口对象
     */
    public static class UserSkuWindow {
        // 初始化 60 个格子，对象仅创建一次，后续全量复用
        final DiskBucket[] buckets = new DiskBucket[WINDOW_SIZE];

        UserSkuWindow() {
            for (int i = 0; i < WINDOW_SIZE; i++) {
                buckets[i] = new DiskBucket(0); // 初始秒数为 0
            }
        }
    }

    // 利用 Caffeine 自带的驱逐策略，彻底干掉自定义的 lastActiveTimestamp 和外部 TimeService
    private final Cache<String, UserSkuWindow> monitorCache = Caffeine.newBuilder()
            .maximumSize(2000000) // 最大承载 200 万个 Key，防 OOM
            .expireAfterAccess(5, TimeUnit.MINUTES) // 5分钟无流量自动剔除僵尸 Key
            .build();

    /**
     * 风控判定核心接口（完美承载 10万 QPS，仅对槽位精准加锁）
     */
    public boolean clickAndCheck(String userId, String skuId) {
        String cacheKey = userId + "_" + skuId;
        long currentSeconds = System.currentTimeMillis() / 1000;
        int index = (int) (currentSeconds % WINDOW_SIZE);

        // 1. 从 Caffeine 获取或创建窗口（纯指针引用，0 序列化）
        UserSkuWindow window = monitorCache.get(cacheKey, k -> new UserSkuWindow());
        DiskBucket bucket = window.buckets[index];

        // 2. 检查当前格子是否已经是“一分钟前甚至更早”的历史脏数据
        if (bucket.timestampSeconds != currentSeconds) {
            // 细粒度锁：只锁这 1 个槽位，不影响其他 59 个槽位的并发写入与统计
            synchronized (bucket) {
                if (bucket.timestampSeconds != currentSeconds) {
                    bucket.counter.reset(); // 过去的值置 0
                    bucket.timestampSeconds = currentSeconds; // 修正为当前秒数
                }
            }
        }

        // 3. 完美的无锁并发累加（LongAdder 内部通过 Cell 数组分流，消灭 CPU 缓存行伪共享）
        bucket.counter.increment();

        // 4. 统计过去 1 分钟（60秒内）所有未过期的有效格子总和
        long totalClicks = 0;
        for (DiskBucket b : window.buckets) {
            // 只有那些没有过期的格子才参与求和（如果某个格子断流了，它的秒数太老，这里直接略过，相当于惰性剔除）
            if (currentSeconds - b.timestampSeconds < WINDOW_SIZE) {
                totalClicks += b.counter.sum();
            }
        }

        // 5. 规则判定：1 分钟内点击不能超过 100 次
        return totalClicks <= 100;
    }
}


2，Flink 版，绝对不要用 flink 的 timewindow ，太笨重，都受 flink 管理，默认是 rockDB，会撑爆(其实可以刷盘)。  还是利用环形数组来解决时间窗口。把计数放到 state 里去受 flink 管理，这样 checkpoint 可以
    使得程序更加健壮，keyby 操作让特定的用户和 product 在同一个实例，流式又使得计数没有竞争。缺点是延迟大于 RPC 版本，不能实时。

##### 这里实现没有考虑到原生 timewindow 方案里的 watermark 支持， 比如：当新事件从数组的一个 slot 切换到 下一个 slot，也就是 index +1， 表明数据过了一个timewindow 的步长，
##### 新的一个timewindow 形成了， 需要统计里面所有数据，如果立马统计，就是不支持迟到数据统计，没有 watermark 概念。 另外新的事件来了，直接找到对应的槽位，把里面的值加 1，这样也
#### 没有区分是不是上轮留下的值。 这里每个事件来了就统计整个区间，不是按步长到了尾部再统计。


StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();
// 1. 设置状态后端为 HashMapBackend
env.setStateBackend(new HashMapStateBackend());
// 2. 必须要配置 Checkpoint 持久化存储路径（比如 HDFS 或 OSS）
// 虽然它叫内存后端，但它的 Checkpoint 副本必须找个地方存下来，
