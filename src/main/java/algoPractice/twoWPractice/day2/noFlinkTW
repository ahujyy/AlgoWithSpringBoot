import org.apache.flink.api.common.functions.RichFlatMapFunction;
import org.apache.flink.api.common.state.ValueState;
import org.apache.flink.api.common.state.ValueStateDescriptor;
import org.apache.flink.configuration.Configuration;
import org.apache.flink.util.Collector;
import java.util.Arrays;

public class FlinkPureMemoryWindowFunction extends RichFlatMapFunction<ClickEvent, AlertResult> {

    // 托管状态：保存 60 个秒格子的数组
    private transient ValueState<long[]> windowState;
    // 托管状态：记录这个 Key 上一次发生点击时的具体秒数
    private transient ValueState<Long> lastUpdateState;

    @Override
    public void open(Configuration parameters) {
        windowState = getRuntimeContext().getState(
            new ValueStateDescriptor<>("window-bucket", long[].class)
        );
        lastUpdateState = getRuntimeContext().getState(
            new ValueStateDescriptor<>("last-sec", Long.class)
        );
    }

    @Override
    public void flatMap(ClickEvent event, Collector<AlertResult> out) throws Exception {
        long currentSeconds = event.getTimestamp() / 1000;
        int index = (int) (currentSeconds % 60);

        // 1. 获取堆内存中的数组引用 (HashMapBackend 下为 O(1) 纯指针获取)
        long[] buckets = windowState.value();
        Long lastSec = lastUpdateState.value();

        if (buckets == null) {
            buckets = new long[60];
            lastSec = currentSeconds;
        }

        // 2. 核心算法：惰性跨度擦除（解决没有流量撞击时，老格子的数据残余问题）
        long gap = currentSeconds - lastSec;
        if (gap > 0) {
            if (gap >= 60) {
                // 如果距离上次点击已经过去超过1分钟，说明全部格子都过期了，直接全部重置为 0
                Arrays.fill(buckets, 0);
            } else {
                // 如果只过去了若干秒，顺着环形缓冲区，把过去这段空白期对应的格子抹平
                for (long i = lastSec + 1; i <= currentSeconds; i++) {
                    buckets[(int) (i % 60)] = 0;
                }
            }
            lastSec = currentSeconds;
            lastUpdateState.update(lastSec);
        }

        // 3. 原地修改！(No Object Creation, No Array Copy)
        buckets[index]++; 

        // 4. 求和过去 1 分钟内的总数
        long totalClicks = 0;
        for (long count : buckets) {
            totalClicks += count;
        }

        // 5. 状态写回（在 HashMap 后端中仅是引用覆盖，极快）
        windowState.update(buckets);

        // 6. 阈值判定
        if (totalClicks > 100) {
            out.collect(new AlertResult(event.getUserId(), event.getSkuId(), totalClicks));
        }
    }
}



1. 10万 QPS 下，你怎么保证“高并发安全”和“极致吞吐”？
分流锁粒度（ConcurrentHashMap）：
10万 QPS 听起来吓人，但由于它是“同一个用户 + 同一个 SKU”，在实际风控中，流量被数万个不同的 Key 彻底摊平。
ConcurrentHashMap 底层使用 CAS 和红黑树的分段无锁化设计，在 Key 足够分散的情况下，几乎没有锁冲突。

消灭锁竞争（LongAdder 阻击伪共享）：
传统的原子类 AtomicLong 底层是 CAS 死循环。当 10万 QPS 撞向同一个热点商品时，多个 CPU 内核会疯狂修改同一个变量，导致 CPU 的 L1/L2 缓存行频繁失效（Cache Line Flashing）。
我在这里使用的是 LongAdder。它在底层维护了一个 Cell[] 数组。当高并发涌入时，不同的线程会被路由到不同的 Cell 里独立累加，最后求 sum()。
这直接把 CPU 的热点竞争转为了多 Cell 的内存分流，达到了真正的 $O(1)$ 无锁吞吐。

单槽轻量锁（Lazy-Reset）：
当时间跨入新的一秒时，旧格子的清空仅锁住当前这 1 个 Slot（槽位），而不是锁住整条用户数据，且一秒只会触发一次 reset()，后续 10万流量依然是无锁的 increment() 进场。



