env.getCheckpointConfig().setCheckpointStorage("hdfs://namenode:4001/flink-checkpoints");
// 3. 开启增量或者周期性 Checkpoint
env.enableCheckpointing(60000); // 每 1 分钟做一次快照


StateTtlConfig ttlConfig = StateTtlConfig
