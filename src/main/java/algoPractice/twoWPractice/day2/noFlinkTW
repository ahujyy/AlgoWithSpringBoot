    .setUpdateType(StateTtlConfig.UpdateType.OnCreateAndWrite)   // 每次写入/修改时刷新生存时间
    .setStateVisibility(StateTtlConfig.StateVisibility.NeverReturnExpired)
    .cleanupInRocksdbCompactFilter() // 如果以后切到 RocksDB 也有用
    .build();

ValueStateDescriptor<long[]> desc = new ValueStateDescriptor<>("window-bucket", long[].class);
