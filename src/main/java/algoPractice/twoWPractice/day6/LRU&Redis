            import org.redisson.api.RSemaphore;
            import org.redisson.api.RedissonClient;
            import org.springframework.beans.factory.annotation.Autowired;
            import org.springframework.stereotype.Service;

            import java.util.concurrent.TimeUnit;

            @Service
            public class SeckillLimitService {

                @Autowired
                private RedissonClient redissonClient;

                // 系统初始化：设置商品秒杀许可数（例如 100 个配额）
                public void initSeckillQuota(String goodsId, int totalQuota) {
                    RSemaphore semaphore = redissonClient.getSemaphore("seckill:quota:" + goodsId);
                    semaphore.trySetPermits(totalQuota); // 初始化信号量为 100
                }

                // 秒杀请求到来时抢夺信号量
                public boolean enterSeckillQueue(String goodsId) {
                    RSemaphore semaphore = redissonClient.getSemaphore("seckill:quota:" + goodsId);

                    try {
                        // 尝试在 500ms 内获取 1 个配额，拿不到说明秒杀已被抢光
                        boolean acquired = semaphore.tryAcquire(1, 500, TimeUnit.MILLISECONDS);
                        if (acquired) {
                            // 成功抢到配额！放行进入后续订单生成流程
                            return true;
                        } else {
                            // 配额耗尽或超时，直接拒绝请求
                            return false;
                        }
                    } catch (InterruptedException e) {
                        Thread.currentThread().interrupt();
                        return false;
                    }
                }
            }

