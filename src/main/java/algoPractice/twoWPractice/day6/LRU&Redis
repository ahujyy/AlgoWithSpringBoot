            import org.redisson.api.RedissonClient;
            import org.springframework.beans.factory.annotation.Autowired;
            import org.springframework.stereotype.Service;

            import java.util.concurrent.TimeUnit;

            @Service
            public class ProductDetailService {

                @Autowired
                private RedissonClient redissonClient;

                // 1. 读操作：并发读取商品信息/缓存（读读共享）
                public String getProductDetail(String goodsId) {
                    RReadWriteLock rwLock = redissonClient.getReadWriteLock("rw:lock:goods:" + goodsId);
                    // 获取读锁
                    rwLock.readLock().lock();
                    try {
                        // 执行读业务（如查 Redis 缓存或 DB）
                        return "商品详情数据";
                    } finally {
                        rwLock.readLock().unlock();
                    }
                }

                // 2. 写操作：秒杀结束更新库存/商品上架（写写互斥，读写互斥）
                public void updateProductDetail(String goodsId) {
                    RReadWriteLock rwLock = redissonClient.getReadWriteLock("rw:lock:goods:" + goodsId);
                    // 获取写锁
                    rwLock.writeLock().lock();
                    try {
                        // 执行写业务（如更新 DB 并淘汰缓存）
                    } finally {
                        rwLock.writeLock().unlock();
                    }
                }
            }

