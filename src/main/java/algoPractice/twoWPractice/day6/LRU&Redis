            import org.redisson.api.RLock;
            import org.redisson.api.RedissonClient;
            import org.springframework.beans.factory.annotation.Autowired;
            import org.springframework.stereotype.Service;

            import java.util.concurrent.TimeUnit;

            @Service
            public class RedissonSeckillService {

                @Autowired
                private RedissonClient redissonClient;

                public void seckillOrderRedisson(String goodsId) {
                    String lockKey = "secskill:lock:" + goodsId;
                    
                    // 1. 获取锁对象 (基于 Hash + Lua 实现的可重入锁)
                    RLock lock = redissonClient.getLock(lockKey);

                    try {
                        // 2. 尝试获取锁：
                        // waitTime = 3 秒（最多等待 3 秒，期间利用 Redis Pub/Sub 挂起等待唤醒，不拉高 CPU）
                        // leaseTime = -1（不写死的租约时间，开启 Watchdog 看门狗自动续期，默认 30 秒周期性续期）
                        boolean isLocked = lock.tryLock(3, -1, TimeUnit.SECONDS);

                        if (isLocked) {
                            try {
                                // 3. 执行核心秒杀逻辑
                                // （即使这里方法内部再调用一个需要同 key 锁的方法，也会凭借可重入性直接通过）
                                doSeckillLogicWithReentrant(goodsId);
                            } finally {
                                // 4. 释放锁：只有持有锁的线程才能释放，且会自动递减重入次数
                                if (lock.isHeldByCurrentThread()) {
                                    lock.unlock();
                                }
                            }
                        } else {
                            // 等待 3 秒仍未抢到锁，触发秒杀限流/降级
                            throw new RuntimeException("秒杀太火爆了，排队失败！");
                        }
                    } catch (InterruptedException e) {
                        Thread.currentThread().interrupt();
                        throw new RuntimeException("系统中断异常");
                    }
                }

                // 验证可重入性
                private void doSeckillLogicWithReentrant(String goodsId) {
                    String lockKey = "secskill:lock:" + goodsId;
                    RLock reentrantLock = redissonClient.getLock(lockKey);
                    
                    // 同一线程再次加锁，无需等待，直接成功（重入计数器 Count 从 1 变成 2）
                    reentrantLock.lock();
                    try {
                        System.out.println("成功重入锁，执行子业务...");
                    } finally {
                        reentrantLock.unlock(); // Count 减为 1，锁依然不释放，直到最外层 unlock()
                    }
                }
            }

