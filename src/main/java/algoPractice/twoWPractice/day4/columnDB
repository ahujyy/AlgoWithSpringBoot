        head = new Node(Integer.MIN_VALUE, "HEAD");
    }

    /**
     * 【核心方法】：查找特定时间戳的订单
     */
    public String search(int targetTimestamp) {
        Node p = head; // 从左上角的最高层起点出发
        
        while (p != null) {
            // 1. 如果右边的节点不为空，且右边的时间戳小于等于目标，就尽情向右“跳”
            while (p.next != null && p.next.timestamp <= targetTimestamp) {
                p = p.next;
            }
            
            // 2. 检查当前位置是否正好命中目标
            if (p.timestamp == targetTimestamp) {
                return p.orderId;
            }
            
            // 3. 如果右边没路了（或者右边太大了），就坐电梯“向下”一层
            p = p.down;
        }
