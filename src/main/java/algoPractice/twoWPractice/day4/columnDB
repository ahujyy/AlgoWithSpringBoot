### 跳表插入
import java.util.Random;

public class MiniSkipList {
    
    static class Node {
        int timestamp;
        String orderId;
        Node next;
        Node down;

        public Node(int timestamp, String orderId) {
            this.timestamp = timestamp;
            this.orderId = orderId;
        }
    }

    private Node head; 
    private final Random random = new Random();
    private int currentMaxLevel = 1; // 当前跳表一共有多少层

    public MiniSkipList() {
        head = new Node(Integer.MIN_VALUE, "HEAD");
    }

    /**
     * 【核心补全】：动态插入节点
     */
    public void insert(int timestamp, String orderId) {
        // 1. 掷硬币决定这个新节点的高度（晋升机制）
        int k = 1;
        while (random.nextDouble() < 0.5) { // 50% 的概率升一层
            k++;
        }

        // 2. 如果随机出来的层数 k 大于目前跳表的最大高度，我们需要强行“盖新楼”
        // 也就是在上面多建几层头节点 head
        while (k > currentMaxLevel) {
            Node newHead = new Node(Integer.MIN_VALUE, "HEAD");
            newHead.down = head; // 新头节点向下指向老头节点
            head = newHead;      // 全局头节点切换到最高层
            currentMaxLevel++;
        }

        // 3. 开始执行插入。由于插入是“多层垂直串联”的，我们需要一个变量来关联上下层的新节点
        Node lastNewNode = null; 
        Node p = head; // 依然从左上角最高层出发
        int currentLevel = currentMaxLevel;

        while (p != null) {
            // 往右荡，直到找到“刚好小于新时间戳”的那个格子的边缘
            while (p.next != null && p.next.timestamp < timestamp) {
                p = p.next;
            }

            // 如果当前层级（currentLevel）小于等于我们随机出来的层高 k，说明这一层该有新节点
            if (currentLevel <= k) {
                Node newNode = new Node(timestamp, orderId);
                
                // 横向织网：把新节点塞进当前层的链表中
                newNode.next = p.next;
                p.next = newNode;

                // 纵向织网：如果上一层也建了新节点，让上一层的新节点向下（down）指向当前层的新节点
                if (lastNewNode != null) {
                    lastNewNode.down = newNode;
                }
                lastNewNode = newNode; // 记录下来，留给下一层用
            }

            // 掉头向下，去下一层继续重复这个织网过程
            p = p.down;
            currentLevel--;
        }
    }
}




