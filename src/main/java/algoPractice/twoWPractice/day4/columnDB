        int timestamp;      // 排序的关键字：时间戳
        String orderId;     // 携带的业务数据：订单ID
        Node next;          // 当前层向右的指针
        Node down;          // 跨层向下的指针

        public Node(int timestamp, String orderId) {
            this.timestamp = timestamp;
            this.orderId = orderId;
        }
    }

    private Node head;     // 跳表左上角的头节点（最顶层电梯的起点）
